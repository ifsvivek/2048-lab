#!/bin/sh
# Launcher for the Java port (copied to bin/g2048 by `make`).
# Single-threaded, allocation-light workload: the serial collector has the
# lowest overhead. G2048_JAVA_OPTS appends/overrides JVM flags.
here=$(dirname "$0")
exec "${JAVA:-java}" -XX:+UseSerialGC -Xms64m -XX:+UseCompressedOops -XX:-UsePerfData \
  ${G2048_JAVA_OPTS:-} -jar "$here/g2048.jar" "$@"
