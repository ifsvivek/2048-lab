{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "g2048-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Service binding: calls the API worker directly (no public hop).
  "services": [{ "binding": "API", "service": "g2048-api" }],
  "vars": { "API_URL": "https://g2048-api.ifsvivek.workers.dev" }
}
